# Copy to .env for local development. Never commit .env.
# [Secret] values must come from a k8s Secret in deployment.

# --- App ---
PORT=8080
LOG_LEVEL=INFO
INTERNAL_SHARED_SECRET=
INTERNAL_SHARED_SECRET_HEADER=X-Internal-Secret
MODELS_OWNED_BY=samsungcard-aim-gateway

# --- Upstream ---
UPSTREAM_MODE=xenon
MODEL_MAP_JSON={"gpt-5.6-sol":{"xenon_model":"<sol revision>","bedrock_model":"global.openai.gpt-5.6-sol"},"gpt-5.6-terra":{"xenon_model":"<terra revision>","bedrock_model":"global.openai.gpt-5.6-terra"},"gpt-5.6-luna":{"xenon_model":"<luna revision>","bedrock_model":"global.openai.gpt-5.6-luna"}}
XENON_UPSTREAM_BASE_URL=http://127.0.0.1:9002/v1
XENON_UPSTREAM_API_KEY=
BEDROCK_BASE_URL=https://bedrock-runtime.ap-northeast-2.amazonaws.com/openai/v1
BEDROCK_AUTH_MODE=api_key
AWS_BEARER_TOKEN_BEDROCK=
UPSTREAM_CONNECT_TIMEOUT_S=10
UPSTREAM_READ_TIMEOUT_S=600
STRIP_REQUEST_FIELDS=
# Request headers forwarded upstream (comma list, trailing * = prefix match)
FORWARD_HEADERS=accept,user-agent,openai-beta,session_id,conversation_id,originator,version,x-request-id,x-client-request-id,x-codex-*,x-stainless-*
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost

# --- AIM (assumed spec — see app/guard/aim_client.py) ---
AIM_BASE_URL=http://127.0.0.1:9001
AIM_CHECK_PATH=/v1/check
AIM_API_KEY=
AIM_API_KEY_HEADER=X-Starfort-Guard-Api-Key
AIM_TIMEOUT_MS=3000
AIM_MAX_CHARS=8000
AIM_CHUNK_OVERLAP=200
AIM_CONCURRENCY=8
AIM_FAIL_MODE=closed

# --- Guard policy ---
GUARD_INPUT_ENABLED=true
GUARD_OUTPUT_ENABLED=true
GUARD_REASONING=skip
TOOL_MASK_POLICY=block
OUTPUT_WINDOW_CHARS=400
OUTPUT_OVERLAP_CHARS=64
GUARD_POLICY_VERSION=1

# --- Cache ---
CACHE_BACKEND=memory
CACHE_MAX_ITEMS=50000
CACHE_TTL_S=86400
REDIS_URL=
